@"
# Virtual environments
venv/
.env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# VSCode settings
.vscode/

# Data files
data/
*.csv
*.tsv
*.xlsx
*.json
*.txt
